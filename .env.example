# Copy to .env.local for local development.

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-app>.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated Google account emails allowed to sign in
ALLOWED_EMAILS=ollie.bondan@gmail.com,aisha.bondan@gmail.com,esti.bondan@gmail.com,alyssatasya@gmail.com,titon@yonex.ch

# Neon Postgres connection string — set automatically by Vercel when the Neon
# database is connected (Storage tab). For local dev copy it from the Neon
# quickstart in the Vercel dashboard. THIS IS A SECRET — .env.local only.
DATABASE_URL=

# Role membership — comma-separated Google account emails per role. Each
# workflow step belongs to exactly one role (see STEPS in lib/types.ts) and
# only members of that role can advance/undo it. Unset falls back to the
# hardcoded defaults in lib/permissions.ts (the real team).
#   FRONT:    receives/hands over/returns rackets, marks payment received
#   STRINGER: strings rackets (view-only in the workflow today — see plan)
#   PAYEE:    confirms payment forwarded/received on Tasya's end
FRONT_EMAILS=ollie.bondan@gmail.com,aisha.bondan@gmail.com,esti.bondan@gmail.com
STRINGER_EMAILS=Titongustaman3011@gmail.com
PAYEE_EMAILS=alyssatasya@gmail.com

# Local dev only: set to 1 to skip Google login entirely (never works in production)
DEV_NO_AUTH=

# Web Push (role-aware "your turn" notifications — see lib/push.ts). Generate
# once with: npx web-push generate-vapid-keys
# Leave all three unset to disable push entirely (the app works fine without it).
# THESE ARE SECRETS — .env.local only, never committed.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Any mailto: address or URL identifying you to push services (Apple/Google/Mozilla).
VAPID_SUBJECT=mailto:you@example.com
